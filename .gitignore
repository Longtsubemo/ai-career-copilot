# ===========================================
# Environment files (secrets live in .env,
# only .env.example templates are tracked)
# ===========================================
.env
.env.*
!.env.example

# ===========================================
# Python
# ===========================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual Environments
.venv/
venv/
env/

# Python build
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ===========================================
# Databases (Postgres runs in Docker;
# local scratch DBs must not be committed)
# ===========================================
*.db
*.sqlite
*.sqlite3
*.sqlite-*
*.dump
*.backup
*.bak
*.sql
*.sql.gz

# Local user uploads/data are not application source. Uploaded resume text is
# currently stored in PostgreSQL, but keep common local export/storage paths out
# of Git if developers add local tooling later.
uploads/
user-data/
local-data/

# ===========================================
# Logs
# ===========================================
*.log

# ===========================================
# Frontend (frontend/.gitignore repeats these)
# ===========================================
node_modules/
frontend/dist/
frontend/coverage/
npm-debug.log*

# ===========================================
# IDE / OS
# ===========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===========================================
# Secrets
# ===========================================
*.pem
*.key
*.crt
