CAREER_COPILOT_APP_NAME="AI Career Copilot API"
CAREER_COPILOT_APP_VERSION="0.1.0"
CAREER_COPILOT_ENVIRONMENT="development"
CAREER_COPILOT_DEBUG=false
CAREER_COPILOT_LOG_LEVEL="INFO"
# Set CAREER_COPILOT_DATABASE_URL privately; do not commit credentials.
CAREER_COPILOT_SEARXNG_BASE_URL="http://localhost:8080"
CAREER_COPILOT_FIRECRAWL_BASE_URL="http://localhost:3002"
CAREER_COPILOT_FIRECRAWL_API_KEY=
CAREER_COPILOT_GEMINI_API_KEY=
CAREER_COPILOT_GEMINI_MODEL="gemini-3.8-flash"
CAREER_COPILOT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CAREER_COPILOT_SESSION_COOKIE_NAME="career_copilot_session"
CAREER_COPILOT_CSRF_COOKIE_NAME="career_copilot_csrf"
CAREER_COPILOT_SESSION_TTL_SECONDS=604800
CAREER_COPILOT_SESSION_COOKIE_SECURE=false
CAREER_COPILOT_SESSION_COOKIE_SAMESITE="lax"

# Local search adapter; use Firecrawl only with a server-side API key.
CAREER_COPILOT_SEARCH_PROVIDER=searxng
